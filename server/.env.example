# Copy to .env and fill in real values
PORT=4000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/wavelength
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/wavelength
MONGO_URI=mongodb://127.0.0.1:27017/wavelength

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=30d

# Jamendo (free, Creative-Commons full tracks). Get a free Client ID at
# https://devportal.jamendo.com. Leave blank to disable the Jamendo rows.
JAMENDO_CLIENT_ID=

# Email (for password reset OTPs). Uses Resend — free 100 emails/day.
# Sign up at https://resend.com → API Keys → Create API Key
# RESEND_FROM: use "Wavelength <onboarding@resend.dev>" until you verify a domain.
RESEND_API_KEY=
RESEND_FROM=Wavelength <onboarding@resend.dev>
