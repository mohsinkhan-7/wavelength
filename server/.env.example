# Copy to .env and fill in real values
PORT=4000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/wavelength
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/wavelength
MONGO_URI=mongodb://127.0.0.1:27017/wavelength

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=30d

# Jamendo (free, Creative-Commons full tracks). Get a free Client ID at
# https://devportal.jamendo.com. Leave blank to disable the Jamendo rows.
JAMENDO_CLIENT_ID=

# Email (for password reset OTPs). Gmail example:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#   SMTP_USER=you@gmail.com   SMTP_PASS=<16-char App Password>
# Generate an App Password at: Google Account → Security → App Passwords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Wavelength <noreply@wavelength.app>
